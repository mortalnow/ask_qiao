PORT=3002
JWT_SECRET=your-super-secret-jwt-key-change-this
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Model Configuration (optional)
# Use 'latest' for auto-discovery of the newest model, or specify exact model name
# Examples for OpenAI: latest, gpt-4o, gpt-4-turbo, gpt-5.2-chat-latest
# Examples for Gemini: latest, gemini-1.5-flash, gemini-2.0-flash, gemini-3-flash-preview
OPENAI_MODEL=latest
GEMINI_MODEL=latest

# MongoDB Atlas Configuration
# Get these from MongoDB Atlas dashboard > Connect > Connect your application
MONGODB_USER=your-mongodb-username
MONGODB_PASSWORD=your-mongodb-password
# Cluster can be just the name (e.g., "cluster0") or full address (e.g., "cluster0.xxxxx.mongodb.net")
MONGODB_CLUSTER=cluster0
MONGODB_DB_NAME=talk_to_qiao

